$formatReportTime = function($value, $format = 'd-m-Y H:i') {
  if ($value === null || $value === '') {
    return '';
  }
  if (is_numeric($value)) {
    return date($format, (int)$value);
  }
  $time = strtotime((string)$value);
  if ($time === false) {
    return (string)$value;
  }
  return date($format, $time);
};
